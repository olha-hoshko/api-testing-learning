{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "moduleResolution": "NodeNext",

    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tests/**/*.ts", "utils/**/*.ts", "playwright.config.ts"]
}
